set $package_upstream __UPSTREAM__;
proxy_pass http://$package_upstream;
proxy_http_version 1.1;
proxy_set_header Connection "";
proxy_set_header Host __HOST__;
proxy_set_header Authorization "";
proxy_set_header Forwarded "";
proxy_set_header X-Forwarded-Prefix "";
proxy_set_header X-Forwarded-Ssl "";
proxy_set_header X-Forwarded-For $remote_addr;
proxy_set_header X-Forwarded-Host __HOST__;
proxy_set_header X-Forwarded-Proto https;
proxy_set_header X-Forwarded-Port __PORT__;
proxy_set_header X-Request-ID $request_id;
proxy_connect_timeout 3s;
proxy_read_timeout 3s;
proxy_send_timeout 10s;
proxy_next_upstream off;
proxy_cache off;
proxy_buffering off;
proxy_intercept_errors off;
add_header Cache-Control no-store always;
error_page 502 = @unavailable;
error_page 504 = @timeout;
error_page 413 = @large;
error_page 400 = /__package_error_400;
error_page 404 = @missing;
