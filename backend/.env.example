# Documentation only: Spring Boot does NOT automatically load this file or root .env.
# Set process environment explicitly, then activate the db profile.
DB_URL=jdbc:postgresql://127.0.0.1:15432/marketplace_dev
DB_USERNAME=marketplace_dev
DB_PASSWORD=
DB_SCHEMA=marketplace
# Absolute, dedicated directory outside static resources; never share across databases/processes.
MEDIA_ROOT=D:/Workspace/ai-portfolio-practice/.local-tools/media-dev
